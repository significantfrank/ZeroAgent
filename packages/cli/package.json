{
  "name": "@zero-agent/cli",
  "version": "0.1.0",
  "description": "Interactive CLI for the ZeroAgent ReAct agent loop.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "zero-agent": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node dist/cli.js",
    "dev": "node --watch dist/cli.js"
  },
  "dependencies": {
    "@zero-agent/agent-loop": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
